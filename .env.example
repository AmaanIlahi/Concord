# Supabase Postgres connection string (Project Settings > Database > Connection string).
# URL-encode any special characters in the password (e.g. # -> %23, $ -> %24).
DATABASE_URL=postgresql://user:password@localhost:5432/concord

# OpenAI API key used for schema mapping, domain classification, embeddings,
# and the LLM judge. Set a usage/budget cap on the OpenAI dashboard directly —
# this app does not enforce one in code.
OPENAI_API_KEY=sk-placeholder

# Production notes (Fly.io):
# - Set these as Fly secrets, not in a committed file:
#     fly secrets set DATABASE_URL=... OPENAI_API_KEY=...
# - No other env vars are required; the app reads its listen port from the
#   Dockerfile's EXPOSE/CMD (8080), which fly launch will detect.
